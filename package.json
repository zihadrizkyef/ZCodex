{
  "name": "zcodex",
  "version": "0.0.1",
  "private": true,
  "description": "Daily coding harness: one neutral event bus, one adapter per agent CLI (claude, opencode, ...).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @zcodex/harness-server",
    "dev:gui": "npm run dev --workspace @zcodex/gui",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
