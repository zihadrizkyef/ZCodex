{
  "name": "zcodex",
  "private": true,
  "version": "0.1.0",
  "description": "ZCodex — GUI desktop (Electron) untuk Codex CLI, desain mengikuti Codex Desktop",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "gen:protocol": "node packages/codex-protocol/scripts/generate.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -b",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron@44.3.0": true,
    "esbuild@0.25.12": true
  }
}
